---
import Layout from '../layouts/Layout.astro';

const patches = [
  {
    version: "v2027.2.1 Stable",
    date: "October 2026",
    badge: "Current Live Build",
    badgeColor: "border-[#ffd166]/40 text-[#ffd166] bg-[#ffd166]/10",
    highlights: [
      "Physics: Reduced goalkeeper rebound rigidity by 18%; keepers now deflect low shots into safer lateral corners instead of directly back into the penalty spot.",
      "Tackles: Added a 0.25s grace-window on lateral slide challenges before the referee considers it a foul.",
      "Performance: WebAssembly memory footprint reduced from 145MB to 88MB, boosting frame stability on 4GB RAM Chromebooks.",
      "Audio: Added dynamic crowd roar resonance when shots rattle off the crossbar."
    ]
  },
  {
    version: "v2027.1.0 Winter Overhaul",
    date: "September 2026",
    badge: "Major Engine Update",
    badgeColor: "border-[#4de3ff]/40 text-[#4de3ff] bg-[#4de3ff]/10",
    highlights: [
      "Rosters: Synchronized all 24 international team rosters with updated 2027 transfer and starting XI lineups.",
      "Bicycle Kicks: Overhauled overhead acrobatic animations; double-tapping shoot on aerial crosses now smoothly aligns striker hips toward the goal.",
      "Rain Weather: Added wet pitch simulation; balls slide with 20% less ground friction, and slide tackles gain extra travel distance.",
      "Gamepad API: Fixed analog trigger deadzones for PlayStation DualSense and Xbox Wireless controllers."
    ]
  },
  {
    version: "v2027.0.5 Ragdoll 2.0 Beta",
    date: "July 2026",
    badge: "Physics Revamp",
    badgeColor: "border-emerald-400/40 text-emerald-300 bg-emerald-950/40",
    highlights: [
      "Ragdoll Skeletal Base: Replaced primitive rigid cylinder hitboxes with an 8-joint inverse kinematics ragdoll model.",
      "Ball Spin Vector: Balls now retain rotational angular velocity after contacting player shins or the post.",
      "AI Positioning: Wing-backs in 4-3-3 now perform intelligent overlapping runs when wingers cut inside."
    ]
  },
  {
    version: "v2026.4.2 Championship Build",
    date: "May 2026",
    badge: "Tournament Release",
    badgeColor: "border-slate-500/40 text-slate-300 bg-white/5",
    highlights: [
      "Tournament Mode: Introduced 16-team knockout brackets with penalty shootouts on aggregate ties.",
      "Penalty Kicks: Added stutter-step runup controls and goalkeeper diving timing mechanics."
    ]
  }
];

const breadcrumbs = [
  { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://superliquidsoccer27.com/" },
  { "@type": "ListItem", "position": 2, "name": "Patch Notes", "item": "https://superliquidsoccer27.com/patch-notes/" }
];
---

<Layout
  title="Patch Notes & Engine Changelog | Super Liquid Soccer 27"
  description="Read the complete version history and engine patch notes for Super Liquid Soccer 27. Track gameplay tuning, ragdoll physics updates, and bug fixes."
  canonical="/patch-notes/"
>
  <div class="py-8 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto space-y-12">
    
    <!-- Header -->
    <div class="space-y-3 border-b border-white/10 pb-6">
      <div class="inline-flex items-center gap-2 text-xs font-mono font-bold text-[#4de3ff]">
        <span>⚡ VERSION HISTORY</span>
        <span>•</span>
        <span>DEVELOPMENT CHANGELOG</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white">
        Super Liquid Soccer 27 Engine Patch Notes
      </h1>
      <p class="text-xs sm:text-sm text-[#8fa3c4] leading-relaxed max-w-3xl">
        Review our detailed changelog tracking every physics balance adjustment, hitbox calibration, WebGL optimization, and roster update across the 2027 competitive season.
      </p>
    </div>

    <!-- Timeline Cards -->
    <div class="space-y-6">
      {patches.map(p => (
        <div class="p-6 sm:p-8 rounded-3xl bg-[#0a1d36] border border-white/10 space-y-4 shadow-lg">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-white/10 pb-3">
            <div class="flex items-center gap-3">
              <h2 class="text-xl font-bold text-white">{p.version}</h2>
              <span class={`text-[10px] font-mono px-2.5 py-0.5 rounded-full border ${p.badgeColor}`}>
                {p.badge}
              </span>
            </div>
            <span class="text-xs font-mono text-[#8fa3c4]">{p.date}</span>
          </div>

          <ul class="space-y-2.5 text-xs sm:text-sm text-slate-300">
            {p.highlights.map(h => (
              <li class="flex items-start gap-2.5 leading-relaxed">
                <span class="text-[#4de3ff] mt-0.5">▹</span>
                <span>{h}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Navigation Footer -->
    <div class="border-t border-white/10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono">
      <a href="/" class="text-[#4de3ff] hover:underline flex items-center gap-1">
        <span>← Back to Super Liquid Soccer 27 Arena</span>
      </a>
      <div class="flex items-center gap-4 text-[#8fa3c4]">
        <a href="/controls/" class="hover:text-white">Key Controls ↗</a>
        <a href="/tactics-guide/" class="hover:text-white">Pro Tactics ↗</a>
        <a href="/new-teams/" class="hover:text-white">Teams & Stats ↗</a>
      </div>
    </div>

  </div>
</Layout>
